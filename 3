import requests
import json
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.backends import default_backend

# === CONFIGURATION ===

# Path to your password-protected key and cert
ENCRYPTED_KEY_PATH = "client.key"
CERT_PATH = "client.crt"

# Output path for the decrypted key
DECRYPTED_KEY_PATH = "decrypted.key"

# Your key password (type exactly as provided)
KEY_PASSWORD = b"optimus"  # Replace with your actual password (in bytes)

# Dynatrace API token
API_TOKEN = "your_dynatrace_api_token_here"  # Replace with your token

# Dynatrace API endpoint
URL = "https://api-platform-mtls.cib.echonet/it_prod-dynatrace-configuration/v1/managementZones"

# Query parameters
params = {
    "problemSelector": 'status("OPEN") AND severityLevel("RESOURCE_CONTENTION")',
    "entitySelector": 'type("HOST")',
    "from": "now-1d",
    "to": "now",
    "pageSize": 10
}

# Request headers
headers = {
    "Authorization": f"Api-Token {API_TOKEN}",
    "Content-Type": "application/json"
}

# === STEP 1: Decrypt the key ===

try:
    with open(ENCRYPTED_KEY_PATH, "rb") as key_file:
        encrypted_key = key_file.read()

    private_key = serialization.load_pem_private_key(
        encrypted_key,
        password=KEY_PASSWORD,
        backend=default_backend()
    )

    with open(DECRYPTED_KEY_PATH, "wb") as decrypted_file:
        decrypted_file.write(
            private_key.private_bytes(
                encoding=serialization.Encoding.PEM,
                format=serialization.PrivateFormat.TraditionalOpenSSL,
                encryption_algorithm=serialization.NoEncryption()
            )
        )

    print("✅ Decryption successful. Using decrypted.key")

except Exception as e:
    print("❌ Failed to decrypt key:", e)
    exit(1)

# === STEP 2: Make the API call ===

try:
    response = requests.get(
        URL,
        headers=headers,
        params=params,
        cert=(CERT_PATH, DECRYPTED_KEY_PATH),
        verify=False  # ❗ Set to CA bundle in production
    )
    response.raise_for_status()

    data = response.json()

    # Print problems if present
    if "problems" in data:
        for problem in data["problems"]:
            print("Problem ID:", problem.get("problemId", "N/A"))
            print("Title:", problem.get("title", "N/A"))
            print("---")
    else:
        print("No problems found.")

except requests.exceptions.RequestException as e:
    print("❌ Request failed:", e)
except json.JSONDecodeError as e:
    print("❌ Failed to parse JSON:", e)
except KeyError as e:
    print("❌ Missing key in response:", e)

from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.backends import default_backend

# Read the encrypted private key (.key) file
with open("client.key", "rb") as key_file:
    encrypted_key = key_file.read()

# Decrypt using your password
password = b"optimus"  # Replace with your actual password
private_key = serialization.load_pem_private_key(
    encrypted_key,
    password=password,
    backend=default_backend()
